<Project Sdk="Microsoft.NET.Sdk">

    <Target Name="IssueCustomWarning" BeforeTargets="BeforeBuild">
        <Warning Text="------ Building $(TargetFramework) using MAUI $(MauiVersion) ------" />
    </Target>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WindowsEnableDebugging>true</WindowsEnableDebugging>
        <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
        <!--<DocumentationMarkdown>$(MSBuildProjectDirectory)\Generated.md</DocumentationMarkdown>-->
    </PropertyGroup>

    <ItemGroup Condition=" '$(Configuration)'=='Release' ">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)'=='Release' ">
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('windows')) == true Or $(TargetFramework.Contains('droid')) == true Or $(TargetFramework.Contains('ios')) == true Or $(TargetFramework.Contains('catalyst')) == true">
        <DefineConstants>$(DefineConstants);ONPLATFORM</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <Title>DrawnUI for .NET MAUI</Title>
        <PackageId>DrawnUi.Maui</PackageId>
        <Description>Cross-platform rendering engine for .NET MAUI to draw your UI with SkiaSharp</Description>
        <PackageTags>maui drawnui skia skiasharp draw ui</PackageTags>
        <PackageIcon>icon128.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <CreatePackage>false</CreatePackage>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;XLS0505</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);CS0108;XLS0501</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Draw\SkiaControl.Legacy.cs" />
        <Compile Remove="Draw\SkiaControl.States.cs" />
        <Compile Remove="Draw\SkiaControlVisual.cs" />
        <Compile Remove="Draw\SkiaGif.cs" />
        <Compile Remove="Internals\ConditionalStyle.cs" />
        <Compile Remove="Internals\Models\ConditionalStyle.cs" />
        <Compile Remove="Platforms\Windows\ViewChainPanel.Windows.cs" />
        <Compile Remove="Platforms\Windows\Views\AngleSwapChainPanel.cs" />
        <Compile Remove="Controls\Extensions\**" />
        <Compile Remove="Draw\Images\**" />
        <Compile Remove="Draw\Scroll\**" />
        <Compile Remove="Features\Effects\**" />
        <Compile Remove="Platforms\Windows\Controls\**" />
        <Compile Remove="Platforms\Windows\NewFolder\**" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\CLAUDE.md" Link="CLAUDE.md" />
        <None Include="..\..\..\CONTRIBUTING.md" Link="CONTRIBUTING.md" />
        <None Include="..\..\..\icon128.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\..\README.md" Link="README.md">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
        <None Include="..\..\Directory.Build.targets" Link="Directory.Build.targets" />
        <None Include="..\Directory.Build.props" Link="Directory.Build.props" />
    </ItemGroup>

    <ItemGroup>
        <!--parsing markdown text-->
        <!--cannot use due to .net runtime bug still being worked out to be fixed-->
        <!--<PackageReference Include="Markdig" Version="0.41.1" />-->
        <PackageReference Include="AppoMobi.Maui.Gestures" Version="3.11.1" />
        <PackageReference Include="CommonMark.NET" Version="0.15.1" />
        <PackageReference Include="Plugin.Maui.ApplePlatform" Version="1.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.148.0" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.148.0" />
        <PackageReference Include="SkiaSharp.Skottie" Version="4.148.0" />
        <PackageReference Include="Svg.Skia" Version="4.9.0" />

        <!--MIT open source-->
        <!--MIT open source .net helpers and extensions-->
        <PackageReference Include="AppoMobi.Specials" Version="10.0.2" />
        <!--caching bitmaps etc-->
        <PackageReference Include="EasyCaching.InMemory" Version="1.9.2" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('windows')) == true">
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.6" />
    </ItemGroup>

    <!-- Define SIMULATOR symbol for iOS ARM64 simulator builds -->
    <PropertyGroup Condition="$(TargetFramework.Contains('ios')) == true AND $(RuntimeIdentifier.Contains('simulator')) == true">
        <DefineConstants>$(DefineConstants);SIMULATOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('catalyst')) == true">
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.6" />
    </ItemGroup>

    <!--
        Our ANGLE build, shipped into the nuget under runtimes/win-x64/native.
        These MUST stay None, never Content: on windows TFMs Content items are indexed into
        the library PRI at their project-relative path, while PackagePath ships them elsewhere,
        so every consumer then fails with MSB3030 looking for lib/<tfm>/DrawnUi.Maui/Platforms/... 
    -->
    <ItemGroup>
        <None Include="Platforms/Windows/Natives/libEGL.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes/win-x64/native/libEGL.dll</PackagePath>
            <Visible>false</Visible>
        </None>
        <None Include="Platforms/Windows/Natives/libGLESv2.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes/win-x64/native/libGLESv2.dll</PackagePath>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <!--
        Windows: replace SkiaSharp's ANGLE next to the app. Flows to the referencing project
        through GetCopyToOutputDirectoryItems, so it covers both unpackaged output and the
        MSIX payload (GetPackagingOutputs includes that output group).
        This is the ProjectReference/source path; the nuget path is nugets/DrawnUi.Maui.targets.
    -->
    <ItemGroup Condition="$(TargetFramework.Contains('windows')) == true">

        <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.148.0" />

        <None Update="Platforms/Windows/Natives/libEGL.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>libEGL.dll</TargetPath>
        </None>
        <None Update="Platforms/Windows/Natives/libGLESv2.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>libGLESv2.dll</TargetPath>
        </None>
    </ItemGroup>

    <!-- Include targets file for NuGet package -->
    <ItemGroup>
        <None Include="../../../nugets/DrawnUi.Maui.targets">
            <Pack>true</Pack>
            <PackagePath>build/DrawnUi.Maui.targets</PackagePath>
        </None>
    </ItemGroup>

    <!--ANDROID ONLY-->
    <ItemGroup Condition="$(TargetFramework.Contains('android')) == true">
        <!--fix android bad alignement-->
        <PackageReference Include="HarfBuzzSharp" Version="14.2.0" />
        <!--native interop todo expose native source ? -->
       <PackageReference Include="AppoMobi.Maui.Native.Android" Version="2.1.1.0-pre" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="Controls\Extensions\**" />
        <EmbeddedResource Remove="Draw\Images\**" />
        <EmbeddedResource Remove="Draw\Scroll\**" />
        <EmbeddedResource Remove="Features\Effects\**" />
        <EmbeddedResource Remove="Platforms\Windows\Controls\**" />
        <EmbeddedResource Remove="Platforms\Windows\NewFolder\**" />
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Remove="Controls\Extensions\**" />
        <MauiXaml Remove="Draw\Images\**" />
        <MauiXaml Remove="Draw\Scroll\**" />
        <MauiXaml Remove="Features\Effects\**" />
        <MauiXaml Remove="Platforms\Windows\Controls\**" />
        <MauiXaml Remove="Platforms\Windows\NewFolder\**" />
    </ItemGroup>

    <ItemGroup>
        <MauiCss Remove="Controls\Extensions\**" />
        <MauiCss Remove="Draw\Images\**" />
        <MauiCss Remove="Draw\Scroll\**" />
        <MauiCss Remove="Features\Effects\**" />
        <MauiCss Remove="Platforms\Windows\Controls\**" />
        <MauiCss Remove="Platforms\Windows\NewFolder\**" />
    </ItemGroup>
    <ItemGroup>
        <AndroidAarLibrary Remove="Controls\Extensions\**" />
        <None Remove="Draw\Images\**" />
        <None Remove="Draw\Scroll\**" />
        <None Remove="Features\Effects\**" />
        <None Remove="Platforms\Windows\NewFolder\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Internals\Handlers\" />
        <Folder Include="Platforms\Apple\Extensions\" />
    </ItemGroup>


