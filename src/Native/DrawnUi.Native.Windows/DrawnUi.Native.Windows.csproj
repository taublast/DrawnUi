<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>x64</Platforms>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    
    <!-- Consumed only by DrawnUi.Maui.Camera (SkiaCamera, Windows audio recording); apps get it transitively. -->
    <!-- Package Metadata -->
    <PackageId>DrawnUi.Native.Windows</PackageId>
    <!-- pack with -p:Version=x.y.z.w (src/Directory.Build.targets would otherwise stamp the DrawnUi version) -->
    <Version>1.0.0</Version>
    <Title>DrawnUI Native Helpers for Windows</Title>
    <Description>DrawnUI native helpers for Windows platform</Description>
    <Authors>Nick Kovalsky aka AppoMobi and contributors</Authors>
    <Copyright>(c) AppoMobi and contributors 2023 - present day</Copyright>
    <PackageProjectUrl>https://github.com/DrawnUi/DrawnUi.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DrawnUi/DrawnUi.Net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include native DLL in NuGet package -->
    <None Include="bin\x64\Debug\AudioEncoderNative.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="'$(Configuration)' == 'Debug'" />
    <None Include="bin\x64\Release\AudioEncoderNative.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="'$(Configuration)' == 'Release'" />
    
    <!-- Include README -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    
    <!-- MSBuild targets copying the dll next to the app (None items, see the file). Kept beside
         the csproj because build/ is gitignored; packed to build\ for direct referencers and to
         buildTransitive\ so apps referencing DrawnUi.Maui.Camera get it too. -->
    <None Include="DrawnUi.Native.Windows.targets" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

</Project>
